FROM node:20-slim
WORKDIR /app

COPY package*.json ./
RUN npm install --include=dev

ARG API_GATEWAY_HOSTPORT
ARG API_GATEWAY_URL
ARG API_GATEWAY_HOST
ENV API_GATEWAY_HOSTPORT=${API_GATEWAY_HOSTPORT}
ENV API_GATEWAY_URL=${API_GATEWAY_URL}
ENV API_GATEWAY_HOST=${API_GATEWAY_HOST}

COPY . .
RUN npm run build

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000
CMD ["npm", "start"]
