# ==============================================================================
# SocialFlow — Environment Variables Template
# Copy to `.env` for local development or configure in Render Blueprint Group
# ==============================================================================

# Security (JWT HS256 secret, minimum 32+ hex/UTF-8 bytes)
JWT_SECRET=replace-with-secure-64-hex-or-random-secret

# Google Gemini AI & LangGraph Agent
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Frontend Proxy Target
API_GATEWAY_URL=http://localhost:8088

# PostgreSQL (Docker Compose / Render)
DB_HOST=localhost
DB_PORT=5435
DB_NAME=socialflow_db
DB_USER=postgres
DB_PASSWORD=password

# Apache Kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9095
KAFKA_BOOTSTRAP_SERVERS=localhost:9095
KAFKA_AUTO_STARTUP=true

# Elasticsearch 8
SPRING_ELASTICSEARCH_URIS=http://localhost:9205

# S3 / MinIO Object Storage
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_PUBLIC_ENDPOINT=http://localhost:9000
AWS_S3_BUCKET=socialflow-media
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadminpassword
