                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/voice/assistant",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ai",
                "voice",
                "assistant"
              ]
            }
          }
        },
        {
