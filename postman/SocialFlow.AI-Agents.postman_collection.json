{
  "info": {
    "name": "SocialFlow — סוכני בינה מלאכותית (Python AI & LangGraph)",
    "description": "קולקציית Postman בעברית להרצת סוכני ה-AI ב-Python (LangGraph, Gemini 3.5 Flash-Lite ו-RAG) דרך API Gateway (http://localhost:8088).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8088" },
    { "key": "jwt_token", "value": "" },
    { "key": "post_id", "value": "1" }
  ],
  "item": [
    {
      "name": "1. סוכן אוטונומי LangGraph (מחקר, ניסוח, מודרציה ופרסום)",
      "item": [
        {
          "name": "1. הרצת סוכן LangGraph — יצירת טיוטה וסקר (ללא פרסום)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"מיקרו-שירותים ו-Kafka בענן\",\n  \"user_id\": 3,\n  \"target_audience\": \"מפתחים ומהנדסי תוכנה\",\n  \"user_approved\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/agent/run",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ai", "agent", "run"]
            }
          }
        },
        {
          "name": "2. הרצת סוכן LangGraph — יצירה ופרסום אוטומטי לפיד",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  if (data.published_post_id) {",
                  "    pm.collectionVariables.set('post_id', String(data.published_post_id));",
                  "    if (pm.environment && pm.environment.name) { pm.environment.set('post_id', String(data.published_post_id)); }",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"ארכיטקטורת סוכני AI עם LangGraph\",\n  \"user_id\": 3,\n  \"target_audience\": \"קהילת טכנולוגיה ובינה מלאכותית\",\n  \"user_approved\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/agent/run",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ai", "agent", "run"]
            }
          }
        }
      ]
    },
    {
      "name": "2. כלי AI, מודרציה ו-RAG (Gemini)",
      "item": [
        {
          "name": "שאלת RAG על הפיד החי (Ask Feed)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"על אילו נושאים הכי מדברים עכשיו בפיד של SocialFlow?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/ask-feed",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ai", "ask-feed"]
            }
          }
        },
        {
          "name": "ניתוח פוסט ובדיקת בטיחות (Analyze)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"בנינו ארכיטקטורת מיקרו-שירותים מלאה עם Spring Boot, Kafka ו-LangGraph!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/analyze",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ai", "analyze"]
            }
          }
        },
        {
          "name": "הצעת תגובות חכמות לפוסט (Smart Replies)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"השקנו היום את שירות ההתראות בזמן אמת שלנו עם Kafka ו-WebSocket!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/smart-replies",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ai", "smart-replies"]
            }
          }
        },
        {
          "name": "מענה חכם בצ'אט (Chat Reply)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sender\": \"נועה לוי\",\n  \"message\": \"היי! ראית את הטופיקים החדשים ב-Kafka?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/chat-reply",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ai", "chat-reply"]
            }
          }
        },
        {
          "name": "בדיקת תקינות שירות ה-AI (Health)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ai", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "3. עוזר קולי (Voice Assistant — STT / TTS / LangGraph)",
      "description": "עוזר קולי מלא בעברית ואנגלית: תמלול אודיו עם Gemini, ניתוב חכם בין צ'אט/RAG/סוכן LangGraph, והפקת דיבור טבעי ב-MP3 עם edge-tts.",
      "item": [
        {
          "name": "עוזר קולי 1 — הפקת דיבור בעברית מטקסט (TTS -> MP3)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"שלום! העוזר הקולי של SocialFlow מחובר ומוכן להפעיל את הסוכנים האוטונומיים שלך.\",\n  \"voice\": \"he-IL-HilaNeural\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/voice/tts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ai", "voice", "tts"]
            }
          }
        },
        {
          "name": "עוזר קולי 2 — תמלול קובץ קול לטקסט (STT)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "audio", "type": "file", "src": "" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/voice/stt",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ai", "voice", "stt"]
            }
          }
        },
        {
          "name": "עוזר קולי 3 — עוזר קולי מלא (צ'אט / RAG / סוכן LangGraph)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "text", "type": "text", "value": "תכתוב לי פוסט על Kafka ומיקרו-שירותים" },
                { "key": "voice", "type": "text", "value": "he-IL-HilaNeural" },
                { "key": "user_id", "type": "text", "value": "3" },
                { "key": "auto_publish", "type": "text", "value": "false" },
                { "key": "return_audio", "type": "text", "value": "json" },
                { "key": "audio", "type": "file", "src": "", "disabled": true }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/voice/assistant",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ai", "voice", "assistant"]
            }
          }
        },
        {
          "name": "עוזר קולי 4 — רשימת הקולות הזמינים (Voices)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/voice/voices",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ai", "voice", "voices"]
            }
          }
        },
        {
          "name": "עוזר קולי 5 — תדרוך יומי קולי (Daily Briefing)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 3,\n  \"voice\": \"he-IL-HilaNeural\",\n  \"return_audio\": \"json\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/voice/briefing",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ai", "voice", "briefing"]
            }
          }
        }
      ]
    }
  ]
}
