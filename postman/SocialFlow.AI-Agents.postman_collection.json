{
  "info": {
    "name": "SocialFlow — סוכני בינה מלאכותית (Python AI & LangGraph)",
    "description": "קולקציית Postman בעברית להרצת סוכני ה-AI ב-Python (LangGraph, Gemini 3.5 Flash-Lite ו-RAG) דרך API Gateway (http://localhost:8088).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8088"
    },
    {
      "key": "jwt_token",
      "value": ""
    },
    {
      "key": "post_id",
      "value": "1"
    },
    {
      "key": "jwtToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "postId",
      "value": "1"
    },
    {
      "key": "cursor",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. סוכן אוטונומי LangGraph (מחקר, ניסוח, מודרציה ופרסום)",
      "item": [
        {
          "name": "1. הרצת סוכן LangGraph — יצירת טיוטה וסקר (ללא פרסום)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"מיקרו-שירותים ו-Kafka בענן\",\n  \"user_id\": 3,\n  \"target_audience\": \"מפתחים ומהנדסי תוכנה\",\n  \"user_approved\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/agent/run",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ai",
                "agent",
                "run"
              ]
            }
          }
        },
        {
          "name": "2. הרצת סוכן LangGraph — יצירה ופרסום אוטומטי לפיד",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  if (data.published_post_id) {",
                  "    pm.collectionVariables.set('post_id', String(data.published_post_id));",
                  "    if (pm.environment && pm.environment.name) { pm.environment.set('post_id', String(data.published_post_id)); }",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"ארכיטקטורת סוכני AI עם LangGraph\",\n  \"user_id\": 3,\n  \"target_audience\": \"קהילת טכנולוגיה ובינה מלאכותית\",\n  \"user_approved\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/agent/run",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ai",
                "agent",
                "run"
              ]
            }
          }
        }
      ]
    },
