    {
      "name": "4. העשרת AI אוטונומית, LLMOps ו-Corrective RAG",
      "description": "הפעלת העשרת Kafka אוטונומית, מדדי LLMOps, חיפוש CRAG v2.0 עם הזרמת SSE והגדרות מנהל.",
      "item": [
        {
          "name": "הפעלת העשרה אוטונומית (POST /enrichment/process)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/enrichment/process",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ai",
                "enrichment",
                "process"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"postId\": 1,\n  \"content\": \"בנינו ארכיטקטורת מיקרו-שירותים עם #בינה_מלאכותית ו-Kafka!\",\n  \"authorId\": 1,\n  \"authorUsername\": \"demo_user\",\n  \"tags\": [\n    \"בינה_מלאכותית\",\n    \"kafka\"\n  ],\n  \"emit_kafka\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Returns enrichment eventType\", function () { pm.expect(data.event_type).to.be.oneOf([\"POST_ENRICHED\", \"CONTENT_FLAGGED\"]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "סטטוס צרכן ההעשרה ב-Kafka",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/enrichment/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ai",
                "enrichment",
                "status"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Has worker status fields\", function () { pm.expect(pm.response.json()).to.have.property(\"kafka_auto_startup\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "מדדי LLMOps (פורמט JSON)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/metrics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ai",
                "metrics"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Has token and latency telemetry\", function () { pm.expect(data).to.have.property(\"active_model\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "מדדי LLMOps (פורמט Prometheus)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/metrics?format=prometheus",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ai",
                "metrics"
              ],
              "query": [
                {
                  "key": "format",
                  "value": "prometheus"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Returns Prometheus text\", function () { pm.expect(pm.response.text()).to.include(\"socialflow_ai_\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "שאלת פיד v2.0 (Corrective RAG + ציטוטים)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/ask-feed",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ai",
                "ask-feed"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"מה הנושאים החמים בפיד על Spring Boot ו-Kafka?\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test(\"CRAG fields present\", function () { pm.expect(data.answer).to.be.a(\"string\"); pm.expect(data.citations).to.be.an(\"array\"); pm.expect(data).to.have.property(\"retrieval_mode\"); pm.expect(data).to.have.property(\"corrected\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "שאלת פיד v2.0 בהזרמה (SSE Stream)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/ask-feed/stream",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ai",
                "ask-feed",
                "stream"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"סכם לי את הפוסטים האחרונים על בינה מלאכותית\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"SSE stream contains done event\", function () { pm.expect(pm.response.text()).to.include(\"event: done\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "עדכון הגדרות AI (ADMIN בלבד)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/config",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ai",
                "config"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"api_key\": \"YOUR_GEMINI_API_KEY\",\n  \"model\": \"gemini-3.5-flash-lite\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK (ADMIN) or 403 Forbidden (USER)\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 403]); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
