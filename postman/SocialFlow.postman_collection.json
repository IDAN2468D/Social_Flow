{
  "info": {
    "name": "SocialFlow API Collection",
    "description": "Full REST API Collection for SocialFlow Microservices (Project 1)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication & Users",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"idan\",\n  \"email\": \"idan@example.com\",\n  \"password\": \"Secret123!\"\n}"
            },
            "url": {
              "raw": "http://localhost:8088/api/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8088",
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"idan\",\n  \"password\": \"Secret123!\"\n}"
            },
            "url": {
              "raw": "http://localhost:8088/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8088",
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Posts & Interactions",
      "item": [
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Hello SocialFlow with Google Gemini! #AI #Microservices\"\n}"
            },
            "url": {
              "raw": "http://localhost:8088/api/v1/posts",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8088",
              "path": ["api", "v1", "posts"]
            }
          }
        },
        {
          "name": "Toggle Like",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "http://localhost:8088/api/v1/posts/1/like",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8088",
              "path": ["api", "v1", "posts", "1", "like"]
            }
          }
        }
      ]
    },
    {
      "name": "Feeds & Search",
      "item": [
        {
          "name": "For You Feed",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8088/api/v1/feed/for-you",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8088",
              "path": ["api", "v1", "feed", "for-you"]
            }
          }
        },
        {
          "name": "Elasticsearch Search",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8088/api/v1/search?q=AI",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8088",
              "path": ["api", "v1", "search"],
              "query": [{ "key": "q", "value": "AI" }]
            }
          }
        }
      ]
    }
  ]
}
