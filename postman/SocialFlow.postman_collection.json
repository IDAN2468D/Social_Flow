    {
      "name": "1. אימות ומשתמשים — טופיק user-events",
      "description": "בקשות אימות וניהול משתמשים השולחות אירועים לטופיק user-events ב-Kafka.",
      "item": [
        {
          "name": "הרשמת משתמש חדש (שומר טוקן אוטומטית)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 or 201\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "const data = pm.response.json();",
                  "const token = data.token || data.accessToken;",
                  "if (token) {",
                  "  if (pm.environment && pm.environment.name) {",
                  "    pm.environment.set(\"jwt_token\", token);",
                  "    pm.environment.set(\"jwtToken\", token);",
                  "  } else {",
                  "    console.warn(\"Select a Postman Environment (e.g. SocialFlow Local) so jwt_token can be saved securely as a secret.\");",
                  "  }",
                  "}",
                  "if (data.refreshToken && pm.environment && pm.environment.name) {",
                  "  pm.environment.set(\"refreshToken\", data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo_user\",\n  \"email\": \"demo_user@example.com\",\n  \"password\": \"YourPassword123!\",\n  \"fullName\": \"משתמש הדגמה\"\n}"
