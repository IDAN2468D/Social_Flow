      "name": "8. אימות, רענון טוקנים והתנתקות (Zero-Trust)",
      "description": "רוטציית Refresh Token והתנתקות מהסשן הנוכחי או מכל הסשנים.",
      "item": [
        {
          "name": "רענון טוקן גישה ו-Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Returns rotated token and refreshToken\", function () { pm.expect(data.token).to.be.a(\"string\"); pm.expect(data.refreshToken).to.be.a(\"string\"); });",
                  "if (data.token) { if (pm.environment && pm.environment.name) { pm.environment.set(\"jwt_token\", data.token); pm.environment.set(\"jwtToken\", data.token); } else { console.warn(\"Select a Postman Environment (e.g. SocialFlow Local) so jwt_token can be saved securely as a secret.\"); } }",
                  "if (data.refreshToken && pm.environment && pm.environment.name) { pm.environment.set(\"refreshToken\", data.refreshToken); }"
                ]
              }
            }
          ]
        },
        {
