{
  "info": {
    "name": "SocialFlow API Collection",
    "description": "Full REST API Collection for SocialFlow Microservices (Project 1)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication & Users",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"idan\",\n  \"email\": \"idan@example.com\",\n  \"password\": \"Secret123!\"\n}"
            },
            "url": {
              "raw": "http://localhost:8088/api/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8088",
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    var token = json.token || json.accessToken;",
                  "    if (token) { pm.collectionVariables.set('jwt_token', token); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"idan\",\n  \"password\": \"Secret123!\"\n}"
            },
            "url": {
              "raw": "http://localhost:8088/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8088",
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Posts & Interactions",
      "item": [
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Hello SocialFlow with Google Gemini! #AI #Microservices\"\n}"
            },
            "url": {
              "raw": "http://localhost:8088/api/v1/posts",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8088",
              "path": ["api", "v1", "posts"]
            }
          }
        },
        {
          "name": "Toggle Like",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "http://localhost:8088/api/v1/posts/1/like",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8088",
              "path": ["api", "v1", "posts", "1", "like"]
            }
          }
        }
      ]
    },
    {
      "name": "Feeds & Search",
      "item": [
        {
          "name": "For You Feed",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8088/api/v1/feed/for-you",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8088",
              "path": ["api", "v1", "feed", "for-you"]
            }
          }
        },
        {
          "name": "Elasticsearch Search",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8088/api/v1/search?q=AI",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8088",
              "path": ["api", "v1", "search"],
              "query": [{ "key": "q", "value": "AI" }]
            }
          }
        }
      ]
    },
    {
      "name": "AI Service & Agents",
      "item": [
        {
          "name": "AI Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8088/api/v1/ai/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8088",
              "path": ["api", "v1", "ai", "health"]
            }
          }
        },
        {
          "name": "AI Agent Run (Publish to Kafka)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Agent published post', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.published_post_id).to.not.be.null;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"חידושים בבינה מלאכותית\",\n  \"user_id\": 1,\n  \"target_audience\": \"קהל רשת חברתית\",\n  \"user_approved\": true\n}"
            },
            "url": {
              "raw": "http://localhost:8088/api/v1/ai/agent/run",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8088",
              "path": ["api", "v1", "ai", "agent", "run"]
            }
          }
        }
      ]
    }
  ]
}
