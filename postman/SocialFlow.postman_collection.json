              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/posts/admin/reindex?batchSize=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "posts",
                "admin",
                "reindex"
              ],
              "query": [
                {
                  "key": "batchSize",
                  "value": "100"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 202 Accepted (or 403 for non-ADMIN)\", function () { pm.expect(pm.response.code).to.be.oneOf([202, 403]); });",
                  "if (pm.response.code === 202) { pm.expect(pm.response.json().status).to.eql(\"REINDEX_ENQUEUED\"); }"
                ]
              }
            }
          ]
