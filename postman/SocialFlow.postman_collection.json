{
  "info": {
    "name": "SocialFlow — כל שירותי המערכת וטופיקי Kafka (בעברית)",
    "description": "קולקציית Postman מלאה בעברית עבור מערכת SocialFlow. כל אחד מ-6 הטופיקים ב-Kafka מקבל תיקייה ייעודית ועובד באופן עצמאי לחלוטין דרך שער הכניסה (http://localhost:8088).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8088" },
    { "key": "jwt_token", "value": "" },
    { "key": "post_id", "value": "1" },
    { "key": "notification_id", "value": "1" },
    { "key": "media_key", "value": "uploads/1/avatar.png" }
  ],
  "item": [
    {
      "name": "1. אימות ומשתמשים — טופיק user-events",
      "description": "בקשות אימות וניהול משתמשים השולחות אירועים לטופיק user-events ב-Kafka.",
      "item": [
        {
          "name": "הרשמת משתמש חדש (שומר טוקן אוטומטית)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  if (data.token) { pm.collectionVariables.set('jwt_token', data.token); if (pm.environment && pm.environment.name) { pm.environment.set('jwt_token', data.token); } }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo_user\",\n  \"email\": \"demo_user@example.com\",\n  \"password\": \"YourPassword123!\",\n  \"fullName\": \"משתמש הדגמה\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "התחברות ושמירת טוקן אוטומטית",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  const token = data.token || data.accessToken;",
                  "  if (token) { pm.collectionVariables.set('jwt_token', token); if (pm.environment && pm.environment.name) { pm.environment.set('jwt_token', token); } }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo_user\",\n  \"password\": \"YourPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "צפייה בפרופיל משתמש",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/profile/demo_user",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "profile", "demo_user"]
            }
          }
        },
        {
          "name": "עדכון פרופיל משתמש",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"עידן קזם\",\n  \"bio\": \"ארכיטקט מיקרו-שירותים ו-Kafka\",\n  \"profileImageUrl\": \"https://example.com/avatar.png\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "profile"]
            }
          }
        },
        {
          "name": "חיפוש משתמשים",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/search?q=demo",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "search"],
              "query": [{ "key": "q", "value": "demo" }]
            }
          }
        },
        {
          "name": "מעקב אחרי משתמש",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/noa/follow",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "noa", "follow"]
            }
          }
        },
        {
          "name": "ביטול מעקב אחרי משתמש",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/noa/follow",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "noa", "follow"]
            }
          }
        }
      ]
    },
    {
      "name": "2. פוסטים, תגובות וסטוריז — טופיק post-events",
      "description": "בקשות ניהול פוסטים, תגובות וסטוריז השולחות אירועים לטופיק post-events ב-Kafka.",
      "item": [
        {
          "name": "יצירת פוסט חדש (שומר מזהה פוסט אוטומטית)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  if (data.id) { pm.collectionVariables.set('post_id', String(data.id)); if (pm.environment && pm.environment.name) { pm.environment.set('post_id', String(data.id)); } }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"פוסט בדיקה בעברית מתוך Postman ישירות לטופיק post-events! #Java #Kafka #SocialFlow\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/posts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "posts"]
            }
          }
        },
        {
          "name": "שליפת פוסט לפי מזהה",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/posts/{{post_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "posts", "{{post_id}}"]
            }
          }
        },
        {
          "name": "הוספת תגובה לפוסט",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"תגובה חדשה בעברית מתוך Postman!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/posts/{{post_id}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "posts", "{{post_id}}", "comments"]
            }
          }
        },
        {
          "name": "שיתוף פוסט (ריפוסט)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quoteComment\": \"פוסט מעולה ששווה לשתף!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/posts/{{post_id}}/repost",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "posts", "{{post_id}}", "repost"]
            }
          }
        },
        {
          "name": "נעיצת או ביטול נעיצת פוסט",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/posts/{{post_id}}/pin",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "posts", "{{post_id}}", "pin"]
            }
          }
        },
        {
          "name": "מחיקת פוסט",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/posts/{{post_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "posts", "{{post_id}}"]
            }
          }
        },
        {
          "name": "שליפת סטוריז פעילים",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/stories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stories"]
            }
          }
        }
      ]
    },
    {
      "name": "3. לייקים ורגשות — טופיק reaction-events",
      "description": "בקשות לייקים ורגשות השולחות אירועים באופן עצמאי לטופיק reaction-events ב-Kafka.",
      "item": [
        {
          "name": "הוספת רגש לפוסט",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reactionType\": \"INSIGHTFUL\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/posts/{{post_id}}/reactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "posts", "{{post_id}}", "reactions"]
            }
          }
        },
        {
          "name": "סימון או ביטול לייק לפוסט",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/posts/{{post_id}}/like",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "posts", "{{post_id}}", "like"]
            }
          }
        },
        {
          "name": "סיכום רגשות לפוסט",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/posts/{{post_id}}/reactions/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "posts", "{{post_id}}", "reactions", "summary"]
            }
          }
        }
      ]
    },
    {
      "name": "4. מדיה ואחסון קבצים — טופיק media-events",
      "description": "בקשות ניהול קבצים ומדיה השולחות אירועים באופן עצמאי לטופיק media-events ב-Kafka.",
      "item": [
        {
          "name": "יצירת קישור להעלאת תמונה (שומר מפתח אוטומטית)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  const saveVar = (k, v) => { if (v) { pm.collectionVariables.set(k, v); if (pm.environment && pm.environment.name) { pm.environment.set(k, v); } } };",
                  "  saveVar('media_key', data.fileKey);",
                  "  saveVar('upload_url', data.uploadUrl);",
                  "  saveVar('access_url', data.accessUrl);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filename\": \"avatar.png\",\n  \"contentType\": \"image/png\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/media/upload-url",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "media", "upload-url"]
            }
          }
        },
        {
          "name": "מחיקת קובץ מדיה",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/media?key={{media_key}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "media"],
              "query": [{ "key": "key", "value": "{{media_key}}" }]
            }
          }
        },
        {
          "name": "העלאת קובץ התמונה שלך בפועל (PUT ל-MinIO)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "image/png" }],
            "body": { "mode": "file", "file": {} },
            "url": "{{upload_url}}"
          }
        },
        {
          "name": "שליפת התמונות שהעליתי וכמות ההעלאות (GET)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/media",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "media"]
            }
          }
        }
      ]
    },
    {
      "name": "5. פיד וחיפוש — טופיק feed-events",
      "description": "בקשות פיד וחיפוש השולחות אירועים באופן עצמאי לטופיק feed-events ב-Kafka.",
      "item": [
        {
          "name": "שליחת אירוע פיד ישירות לטופיק",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventType\": \"FEED_REFRESHED\",\n  \"feedType\": \"FOR_YOU\",\n  \"message\": \"רענון פיד מתוך Postman ישירות לטופיק feed-events!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/feed/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "feed", "events"]
            }
          }
        },
        {
          "name": "פיד מותאם אישית (עבורך)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/feed/for-you?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "feed", "for-you"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "אנליטיקת משתמש (Analytics)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "http://localhost:8088/api/v1/feed/analytics?userId=1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8088",
              "path": ["api", "v1", "feed", "analytics"],
              "query": [{ "key": "userId", "value": "1" }]
            }
          }
        }
      ]
    },
    {
      "name": "AI Service & Agents",
      "item": [
        {
          "name": "AI Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8088/api/v1/ai/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8088",
              "path": ["api", "v1", "ai", "health"]
            }
          }
        },
        {
          "name": "AI Agent Run (Publish to Kafka)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Agent published post', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.published_post_id).to.not.be.null;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"חידושים בבינה מלאכותית\",\n  \"user_id\": 1,\n  \"target_audience\": \"קהל רשת חברתית\",\n  \"user_approved\": true\n}"
            },
            "url": {
              "raw": "http://localhost:8088/api/v1/ai/agent/run",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8088",
              "path": ["api", "v1", "ai", "agent", "run"]
            }
          }
        }
      ]
    }
  ]
}
