    {
      "name": "Admin & ES Reconciliation",
      "description": "ADMIN-only outbox snapshot reindexing from PostgreSQL to Elasticsearch.",
      "item": [
        {
          "name": "Reindex All Posts to Elasticsearch (ADMIN)",
          "request": {
            "method": "POST",
